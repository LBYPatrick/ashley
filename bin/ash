#!/bin/bash
set -euo pipefail

# Resolve the real script location (follows symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ASHLEY_ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"

# Development-checkout launcher. Release installations contain the binary itself.
if [[ ! -x "$ASHLEY_ROOT/build/ash-go" ]]; then
    make -C "$ASHLEY_ROOT" build
fi
exec "$ASHLEY_ROOT/build/ash-go" "$@"
